PORT=8000
NODE_ENV=development
LOG_LEVEL=debug
API_URL=http://192.168.1.21:8000
HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CRM
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_key_change_in_production_min32chars

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend URL (used in password reset email)
FRONTEND_URL=http://localhost:3000

# SMTP Email (Mailtrap for dev — update for production)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
MAIL_FROM_NAME=CRM System
MAIL_FROM_ADDRESS=noreply@crm.com